{
  "manifest_version": 3,
  "name": "IP Player — M3U / DASH / HLS / Smooth Streaming",
  "short_name": "IP Player",
  "description": "Reproductor de listas M3U con soporte para DASH, HLS y Smooth Streaming (ISM), con DRM ClearKey, Widevine y servidores de licencias.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Abrir IP Player",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "contextMenus",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
